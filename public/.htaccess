# ==============================================================================
# Tanzania Biashara Festival (TBF) - cPanel Production Configuration
# ==============================================================================

DirectoryIndex index.html public/index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
    RewriteRule ^(booking|about|sponsors|events|news|contacts|login)/?$ index.html [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Force fresh HTML and JS on mobile browsers and cPanel Nginx/proxy caches
    <FilesMatch "\.(html|htm|js|css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<FilesMatch "^\.|\.(env|json|sql|log|md|sh|lock|git|secret|auth_secret)$">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
