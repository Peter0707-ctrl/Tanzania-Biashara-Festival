NODE_ENV=production
TBF_DEBUG=0
PORT=3000
TBF_ADMIN_EMAIL=info@biasharafestival.co.tz
TBF_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12_CHARS
TBF_MAIL_FROM=info@biasharafestival.co.tz
TBF_MAIL_NAME=Tanzania Biashara Festival
# Optional 64-char hex secret (if omitted, generated securely in data/.auth_secret)
# TBF_SESSION_SECRET=

# ==============================================================================
# cPanel MySQL Configuration (Optional)
# If DB_TYPE=mysql is set with credentials, TBF connects to cPanel MySQL.
# If omitted or unavailable, TBF automatically degrades gracefully to atomic db.json.
# ==============================================================================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reliancetech_tbf
DB_USER=reliancetech_tbf
DB_PASS=YourDatabasePasswordHere

# ==============================================================================
# Selcom Payment Gateway Configuration (Official Selcom Checkout & USSD Push API)
# ==============================================================================
SELCOM_VENDOR_ID=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_WEBHOOK_URL=https://biasharafestival.co.tz/api/webhooks/selcom
